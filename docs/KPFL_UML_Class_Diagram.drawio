id="lg_h1" value="Relationships" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontStyle=1;fontSize=13;" vertex="1" parent="legend"><mxGeometry x="16" y="38" width="300" height="22" as="geometry"/></mxCell><mxCell id="lg_e0" value="" style="html=1;fontSize=12;endArrow=block;endFill=0;endSize=12;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="80" as="sourcePoint"/><mxPoint x="140" y="80" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg_t0" value="&lt;b&gt;Inheritance&lt;/b&gt; (is-a): the hollow triangle points to the superclass.&lt;br&gt;&lt;i&gt;e.g. Player → Person&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="160" y="64" width="524" height="32" as="geometry"/></mxCell><mxCell id="lg_e1" value="" style="html=1;fontSize=12;endArrow=block;endFill=0;endSize=12;dashed=1;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="118" as="sourcePoint"/><mxPoint x="140" y="118" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg_t1" value="&lt;b&gt;Interface realization&lt;/b&gt;: dashed line, triangle points to the interface.&lt;br&gt;&lt;i&gt;e.g. Ticket → Taxable&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="160" y="102" width="524" height="32" as="geometry"/></mxCell><mxCell id="lg_e2" value="" style="html=1;fontSize=12;startArrow=diamondThin;startFill=1;startSize=16;endArrow=none;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="156" as="sourcePoint"/><mxPoint x="140" y="156" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg_t2" value="&lt;b&gt;Composition&lt;/b&gt;: filled diamond on the whole; the part cannot exist without it.&lt;br&gt;&lt;i&gt;e.g. Fixture ◆— MatchResult&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="160" y="140" width="524" height="32" as="geometry"/></mxCell><mxCell id="lg_e3" value="" style="html=1;fontSize=12;startArrow=diamondThin;startFill=0;startSize=16;endArrow=none;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="194" as="sourcePoint"/><mxPoint x="140" y="194" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg_t3" value="&lt;b&gt;Aggregation&lt;/b&gt;: hollow diamond on the whole; the part also exists on its own.&lt;br&gt;&lt;i&gt;e.g. FootballTeam ◇— Player&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="160" y="178" width="524" height="32" as="geometry"/></mxCell><mxCell id="lg_e4" value="" style="html=1;fontSize=12;endArrow=open;endSize=10;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="232" as="sourcePoint"/><mxPoint x="140" y="232" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg_t4" value="&lt;b&gt;Association&lt;/b&gt;: the open arrow points to the class being referenced.&lt;br&gt;&lt;i&gt;e.g. Fixture → Stadium&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="160" y="216" width="524" height="32" as="geometry"/></mxCell><mxCell id="lg_m" value="" style="html=1;fontSize=12;endArrow=none;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="270" as="sourcePoint"/><mxPoint x="140" y="270" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg_m_s" value="1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=12;" vertex="1" connectable="0" parent="lg_m"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="2" y="-3" as="offset"/></mxGeometry></mxCell><mxCell id="lg_m_t" value="0..*" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=12;" vertex="1" connectable="0" parent="lg_m"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-2" y="-3" as="offset"/></mxGeometry></mxCell><mxCell id="lg_mt" value="&lt;b&gt;Multiplicity&lt;/b&gt;, read across the line: 1 = exactly one · 0..1 = none or one&lt;br&gt;0..* = any number · 1..* = at least one · 2 = exactly two" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="160" y="254" width="524" height="32" as="geometry"/></mxCell><mxCell id="lg_hv" value="" style="html=1;fontSize=12;endArrow=none;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="294" as="sourcePoint"/><mxPoint x="80" y="322" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg_hh" value="" style="html=1;fontSize=12;endArrow=none;jumpStyle=arc;jumpSize=10;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="308" as="sourcePoint"/><mxPoint x="140" y="308" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg_ht" value="&lt;b&gt;Line hop&lt;/b&gt;: the two lines cross without connecting." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="160" y="292" width="524" height="32" as="geometry"/></mxCell><mxCell id="lg_h2" value="Class members" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontStyle=1;fontSize=13;" vertex="1" parent="legend"><mxGeometry x="16" y="338" width="300" height="22" as="geometry"/></mxCell><mxCell id="lg_c0" value="&lt;b&gt;+&lt;/b&gt; public &amp;nbsp;·&amp;nbsp; &lt;b&gt;-&lt;/b&gt; private &amp;nbsp;·&amp;nbsp; &lt;b&gt;#&lt;/b&gt; protected (visible to subclasses)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="20" y="364" width="664" height="22" as="geometry"/></mxCell><mxCell id="lg_c1" value="&lt;b&gt;name: Type&lt;/b&gt; for every attribute and parameter; a long signature continues on an indented line" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="20" y="388" width="664" height="22" as="geometry"/></mxCell><mxCell id="lg_c2" value="&lt;u&gt;Underlined&lt;/u&gt; member = static (belongs to the class, not to each object)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="20" y="412" width="664" height="22" as="geometry"/></mxCell><mxCell id="lg_c3" value="&lt;i&gt;Italic&lt;/i&gt; name or &lt;i&gt;{abstract}&lt;/i&gt; = abstract (class cannot be created; operation must be overridden)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="20" y="436" width="664" height="22" as="geometry"/></mxCell><mxCell id="lg_c4" value="«interface» = a set of operations that implementing classes must provide" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="20" y="460" width="664" height="22" as="geometry"/></mxCell><mxCell id="lg_c5" value="«enumeration» = a fixed list of allowed values, used as a type (e.g. status: TeamStatus)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="20" y="484" width="664" height="22" as="geometry"/></mxCell><mxCell id="lg_h3" value="Colours" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontStyle=1;fontSize=13;" vertex="1" parent="legend"><mxGeometry x="16" y="520" width="300" height="22" as="geometry"/></mxCell><mxCell id="lg_s0" value="" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="legend"><mxGeometry x="20" y="551" width="30" height="18" as="geometry"/></mxCell><mxCell id="lg_st0" value="Abstract classes and interface" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="60" y="548" width="280" height="24" as="geometry"/></mxCell><mxCell id="lg_s1" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="legend"><mxGeometry x="360" y="551" width="30" height="18" as="geometry"/></mxCell><mxCell id="lg_st1" value="Person hierarchy" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="400" y="548" width="280" height="24" as="geometry"/></mxCell><mxCell id="lg_s2" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="legend"><mxGeometry x="20" y="579" width="30" height="18" as="geometry"/></mxCell><mxCell id="lg_st2" value="League operations" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="60" y="576" width="280" height="24" as="geometry"/></mxCell><mxCell id="lg_s3" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="legend"><mxGeometry x="360" y="579" width="30" height="18" as="geometry"/></mxCell><mxCell id="lg_st3" value="Match-day services (tickets and shop)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="400" y="576" width="280" height="24" as="geometry"/></mxCell><mxCell id="lg_s4" value="" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="legend"><mxGeometry x="20" y="607" width="30" height="18" as="geometry"/></mxCell><mxCell id="lg_st4" value="Enumerations" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="60" y="604" width="280" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>