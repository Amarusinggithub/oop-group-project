1" source="Spectator" target="Ticket"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22_s" value="1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=top;fontSize=12;" vertex="1" connectable="0" parent="e22"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="10" y="2" as="offset"/></mxGeometry></mxCell><mxCell id="e22_t" value="0..*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=12;" vertex="1" connectable="0" parent="e22"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="10" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;jumpStyle=arc;jumpSize=10;endArrow=open;endSize=10;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="Spectator" target="Transaction"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23_s" value="1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=12;" vertex="1" connectable="0" parent="e23"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="6" y="-4" as="offset"/></mxGeometry></mxCell><mxCell id="e23_t" value="0..*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=12;" vertex="1" connectable="0" parent="e23"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="10" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;jumpStyle=arc;jumpSize=10;endArrow=open;endSize=10;exitX=1;exitY=0.1829;entryX=0;entryY=0.1899;" edge="1" parent="1" source="Transaction" target="Product"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24_s" value="0..*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=12;" vertex="1" connectable="0" parent="e24"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="6" y="-4" as="offset"/></mxGeometry></mxCell><mxCell id="e24_t" value="1..*" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=12;" vertex="1" connectable="0" parent="e24"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-6" y="-4" as="offset"/></mxGeometry></mxCell><mxCell id="e25" value="(has-a)" style="labelBackgroundColor=#ffffff;fontColor=#555555;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;jumpStyle=arc;jumpSize=10;startArrow=diamondThin;startFill=1;startSize=16;endArrow=none;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="Shop" target="Transaction"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25_s" value="1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=12;" vertex="1" connectable="0" parent="e25"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="10" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="e25_t" value="0..*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=top;fontSize=12;" vertex="1" connectable="0" parent="e25"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="10" y="2" as="offset"/></mxGeometry></mxCell><mxCell id="e26" value="(has-a)" style="labelBackgroundColor=#ffffff;fontColor=#555555;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;jumpStyle=arc;jumpSize=10;startArrow=diamondThin;startFill=0;startSize=16;endArrow=none;exitX=0.85;exitY=0;entryX=0.15;entryY=1;" edge="1" parent="1" source="Shop" target="Product"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e26_s" value="1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=12;" vertex="1" connectable="0" parent="e26"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="10" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="e26_t" value="0..*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=top;fontSize=12;" vertex="1" connectable="0" parent="e26"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="10" y="2" as="offset"/></mxGeometry></mxCell><mxCell id="e27" value="(has-a)" style="labelBackgroundColor=#ffffff;fontColor=#555555;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;jumpStyle=arc;jumpSize=10;startArrow=diamondThin;startFill=1;startSize=16;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="Stadium" target="Shop"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060.0" y="2570"/><mxPoint x="2320.0" y="2570"/></Array></mxGeometry></mxCell><mxCell id="e27_s" value="1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=top;fontSize=12;" vertex="1" connectable="0" parent="e27"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="10" y="2" as="offset"/></mxGeometry></mxCell><mxCell id="e27_t" value="1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=top;fontSize=12;" vertex="1" connectable="0" parent="e27"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="10" y="2" as="offset"/></mxGeometry></mxCell><mxCell id="title" value="KPFL – Jamaican Football League &amp;amp; Match-Day Management System: UML Class Diagram" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="legend" value="Legend" style="swimlane;startSize=30;html=1;fontStyle=1;fontSize=14;collapsible=0;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#fffdf3;" vertex="1" parent="1"><mxGeometry x="40" y="2067" width="700" height="716" as="geometry"/></mxCell><mxCell id="lg_h1" value="Relationships" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontStyle=1;fontSize=13;" vertex="1" parent="legend"><mxGeometry x="16" y="38" width="300" height="22" as="geometry"/></mxCell><mxCell id="lg_e0" value="" style="html=1;fontSize=12;endArrow=block;endFill=0;endSize=12;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="80" as="sourcePoint"/><mxPoint x="140" y="80" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg_t0" value="&lt;b&gt;Inheritance&lt;/b&gt; (is-a): the hollow triangle points to the superclass.&lt;br&gt;&lt;i&gt;e.g. Player → Person&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="160" y="64" width="524" height="32" as="geometry"/></mxCell><mxCell id="lg_e1" value="" style="html=1;fontSize=12;endArrow=block;endFill=0;endSize=12;dashed=1;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="118" as="sourcePoint"/><mxPoint x="140" y="118" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg_t1" value="&lt;b&gt;Interface realization&lt;/b&gt;: dashed line, triangle points to the interface.&lt;br&gt;&lt;i&gt;e.g. Ticket → Taxable&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="160" y="102" width="524" height="32" as="geometry"/></mxCell><mxCell id="lg_e2" value="" style="html=1;fontSize=12;startArrow=diamondThin;startFill=1;startSize=16;endArrow=none;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="156" as="sourcePoint"/><mxPoint x="140" y="156" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg_t2" value="&lt;b&gt;Composition&lt;/b&gt;: filled diamond on the whole; the part cannot exist without it.&lt;br&gt;&lt;i&gt;e.g. Fixture ◆— MatchResult&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="160" y="140" width="524" height="32" as="geometry"/></mxCell><mxCell id="lg_e3" value="" style="html=1;fontSize=12;startArrow=diamondThin;startFill=0;startSize=16;endArrow=none;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="194" as="sourcePoint"/><mxPoint x="140" y="194" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg_t3" value="&lt;b&gt;Aggregation&lt;/b&gt;: hollow diamond on the whole; the part also exists on its own.&lt;br&gt;&lt;i&gt;e.g. FootballTeam ◇— Player&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="160" y="178" width="524" height="32" as="geometry"/></mxCell><mxCell id="lg_e4" value="" style="html=1;fontSize=12;endArrow=open;endSize=10;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="232" as="sourcePoint"/><mxPoint x="140" y="232" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg_t4" value="&lt;b&gt;Association&lt;/b&gt;: the open arrow points to the class being referenced.&lt;br&gt;&lt;i&gt;e.g. Fixture → Stadium&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="160" y="216" width="524" height="32" as="geometry"/></mxCell><mxCell id="lg_m" value="" style="html=1;fontSize=12;endArrow=none;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="270" as="sourcePoint"/><mxPoint x="140" y="270" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg_m_s" value="1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=12;" vertex="1" connectable="0" parent="lg_m"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="2" y="-3" as="offset"/></mxGeometry></mxCell><mxCell id="lg_m_t" value="0..*" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=12;" vertex="1" connectable="0" parent="lg_m"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-2" y="-3" as="offset"/></mxGeometry></mxCell><mxCell id="lg_mt" value="&lt;b&gt;Multiplicity&lt;/b&gt;, read across the line: 1 = exactly one · 0..1 = none or one&lt;br&gt;0..* = any number · 1..* = at least one · 2 = exactly two" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="160" y="254" width="524" height="32" as="geometry"/></mxCell><mxCell id="lg_hv" value="" style="html=1;fontSize=12;endArrow=none;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="294" as="sourcePoint"/><mxPoint x="80" y="322" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg_hh" value="" style="html=1;fontSize=12;endArrow=none;jumpStyle=arc;jumpSize=10;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="308" as="sourcePoint"/><mxPoint x="140" y="308" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg_ht" value="&lt;b&gt;Line hop&lt;/b&gt;: the two lines cross without connecting." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="160" y="292" width="524" height="32" as="geometry"/></mxCell><mxCell id="lg_h2" value="Class members" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontStyle=1;fontSize=13;" vertex="1" parent="legend"><mxGeometry x="16" y="338" width="300" height="22" as="geometry"/></mxCell><mxCell id="lg_c0" value="&lt;b&gt;+&lt;/b&gt; public &amp;nbsp;·&amp;nbsp; &lt;b&gt;-&lt;/b&gt; private &amp;nbsp;·&amp;nbsp; &lt;b&gt;#&lt;/b&gt; protected (visible to subclasses) &amp;nbsp;·&amp;nbsp; &lt;b&gt;~&lt;/b&gt; package (same package only)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="20" y="364" width="664" height="22" as="geometry"/></mxCell><mxCell id="lg_c1" value="&lt;b&gt;name: Type&lt;/b&gt; for every attribute and parameter; a long signature continues on an indented line" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="20" y="388" width="664" height="22" as="geometry"/></mxCell><mxCell id="lg_c2" value="&lt;u&gt;Underlined&lt;/u&gt; member = static (belongs to the class, not to each object)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="20" y="412" width="664" height="22" as="geometry"/></mxCell><mxCell id="lg_c3" value="&lt;i&gt;Italic&lt;/i&gt; name or &lt;i&gt;{abstract}&lt;/i&gt; = abstract (class cannot be created; operation must be overridden)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="20" y="436" width="664" height="22" as="geometry"/></mxCell><mxCell id="lg_c4" value="«interface» = a set of operations that implementing classes must provide" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="20" y="460" width="664" height="22" as="geometry"/></mxCell><mxCell id="lg_c5" value="«enumeration» = a fixed list of allowed values, used as a type (e.g. status: TeamStatus)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="20" y="484" width="664" height="22" as="geometry"/></mxCell><mxCell id="lg_h3" value="Colours" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontStyle=1;fontSize=13;" vertex="1" parent="legend"><mxGeometry x="16" y="520" width="300" height="22" as="geometry"/></mxCell><mxCell id="lg_s0" value="" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="legend"><mxGeometry x="20" y="551" width="30" height="18" as="geometry"/></mxCell><mxCell id="lg_st0" value="Abstract classes and interface" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="60" y="548" width="280" height="24" as="geometry"/></mxCell><mxCell id="lg_s1" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="legend"><mxGeometry x="360" y="551" width="30" height="18" as="geometry"/></mxCell><mxCell id="lg_st1" value="Person hierarchy" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="400" y="548" width="280" height="24" as="geometry"/></mxCell><mxCell id="lg_s2" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="legend"><mxGeometry x="20" y="579" width="30" height="18" as="geometry"/></mxCell><mxCell id="lg_st2" value="League operations" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="60" y="576" width="280" height="24" as="geometry"/></mxCell><mxCell id="lg_s3" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="legend"><mxGeometry x="360" y="579" width="30" height="18" as="geometry"/></mxCell><mxCell id="lg_st3" value="Match-day services (tickets and shop)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="400" y="576" width="280" height="24" as="geometry"/></mxCell><mxCell id="lg_s4" value="" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="legend"><mxGeometry x="20" y="607" width="30" height="18" as="geometry"/></mxCell><mxCell id="lg_st4" value="Enumerations" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="60" y="604" width="280" height="24" as="geometry"/></mxCell><mxCell id="lg_e5" value="" style="html=1;fontSize=12;endArrow=open;endSize=10;dashed=1;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="652" as="sourcePoint"/><mxPoint x="140" y="652" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg_t5" value="&lt;b&gt;Dependency&lt;/b&gt; «use»: dashed open arrow; the class calls or creates the other one." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="160" y="640" width="524" height="24" as="geometry"/></mxCell><mxCell id="lg_s5" value="" style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="legend"><mxGeometry x="20" y="683" width="30" height="18" as="geometry"/></mxCell><mxCell id="lg_st5" value="Console menus and file storage" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="legend"><mxGeometry x="60" y="680" width="280" height="24" as="geometry"/></mxCell><mxCell id="pkg_title" value="Console menus (oop_project.menu) and file storage (oop_project.persistence)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="3147" width="1100" height="34" as="geometry"/></mxCell><mxCell id="pkg_note" value="Main loads the data and opens MainMenu. MainMenu opens one menu per SRS area and passes it the FootballLeague and the InputHelper. Every area menu holds those two (- league: FootballLeague, - input: InputHelper), checks input through InputHelper, catches LeagueException, prints its message and returns to the same menu. Classes in entities never read input or print; FootballLeague.saveData() and loadData() hand off to LeagueFileManager." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="2140" y="3207" width="780" height="110" as="geometry"/></mxCell><mxCell id="Main" value="Main" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;marginBottom=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="3207" width="360" height="103" as="geometry"/></mxCell><mxCell id="Main_a" value="&lt;u&gt;+ LEAGUE_NAME: String&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ SEASON: int = 2026&lt;/u&gt;" style="text;strokeColor=none;fillColor=none